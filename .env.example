GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id"}
GOOGLE_DRIVE_FOLDER_ID=your-folder-id
# Optional: groups can also be added with !addgroup. Comma-separated IDs ending in @g.us.
WHATSAPP_GROUP_IDS=
# Required: international phone number with country code and digits only, e.g. 254712345678.
WHATSAPP_PHONE_NUMBER=
# Optional: directory for persistent WhatsApp credentials; mount persistent storage here.
WHATSAPP_AUTH_PATH=
SCHEDULE_TIMEZONE=Africa/Nairobi
# Optional: private token (12+ characters) that enables the /pause, /resume and /status links.
ADMIN_TOKEN=
# Optional: last day posts are sent (inclusive). Default 2026-12-05.
LAST_POST_DATE=2026-12-05
